--Right Join
SELECT c.id FROM cliente c
RIGHT JOIN entrega e ON c.id = e.cliente_id
WHERE c.id = 10;

--Self Join
select c1.nome, c2.nome, e1.cidade
from cliente c1, cliente c2, endereco e1, endereco e2
where c1.nome <> c2.nome 
and e1.cidade = e2.cidade
and c1.endereco_id = e1.id 
and c2.endereco_id = e2.id 
order by e1.cidade;

select c1.nome, c2.nome, e1.cidade
from cliente c1, cliente c2, endereco e1, endereco e2
where c1.nome <> c2.nome 
and e1.cidade = e2.cidade
and c1.endereco_id = e1.id 
and c2.endereco_id = e2.id 
and (c1.nome like 'Lavínia%'
or c2.nome like 'Lavínia%')
order by e1.cidade;

--Left Join
SELECT endereco.cep, cliente.id
FROM endereco
LEFT JOIN cliente
ON endereco.id = cliente.endereco_id
ORDER BY endereco.cep;

--Inner Join
SELECT cep
FROM endereco
INNER JOIN cliente
ON endereco.id = cliente.endereco_id;

--Full Join 
SELECT * FROM entrega e
FULL JOIN produtos p ON p.id = e.produtos_id
WHERE p.id = 25;
